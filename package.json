{
  "name": "rxdb-debugger-monorepo",
  "license": "MIT",
  "scripts": {
    "build": "bunup && bun run --filter @rxdb-debugger/core build:ui",
    "build:extension": "bun run --filter @rxdb-debugger/chrome-extension build",
    "dev": "bunup --watch",
    "type-check": "bun run --filter '*' type-check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "bunup": "^0.16.20",
    "typescript": "^5.9.3"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module"
}
