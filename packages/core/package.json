{
  "name": "@rxdb-debugger/core",
  "version": "0.1.0",
  "description": "Headless RxDB debugger with live/snapshot query support",
  "homepage": "https://github.com/sirajchokshi/rxdb-debugger/tree/main/packages/core#readme",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirajchokshi/rxdb-debugger.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "peerDependencies": {
    "rxdb": ">=15.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "rxdb": "16.21.1",
    "rxjs": "7.8.2",
    "tsdown": "^0.20.1",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
