{
  "name": "@rxdb-debugger/core",
  "version": "0.1.0",
  "description": "Headless RxDB debugger with live/snapshot query support",
  "homepage": "https://github.com/sirajchokshi/rxdb-debugger/tree/main/packages/core#readme",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirajchokshi/rxdb-debugger.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ui": "vite build"
  },
  "peerDependencies": {
    "rxdb": ">=15.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "rxdb": "16.21.1",
    "rxjs": "7.8.2",
    "solid-js": "^1.9.0",
    "typescript": "5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-solid": "^2.11.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
