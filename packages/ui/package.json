{
  "name": "@rxdb-debugger/ui",
  "version": "0.1.0",
  "description": "SolidJS UI components for RxDB debugger",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@rxdb-debugger/core": ">=0.1.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@rxdb-debugger/core": "workspace:*",
    "rolldown-plugin-solid": "^0.2.0",
    "rxdb": "16.21.1",
    "solid-js": "^1.9.0",
    "tsdown": "^0.20.1",
    "typescript": "^5.7.3"
  }
}
